{
  "manifest_version": 2,
  "name": "ZotLink",
  "version": "0.3.1",
  "description": "Moves Zotero linked attachments, mirrors collections with shortcuts, and repairs links by Windows file ID.",
  "author": "Yihtsy <yihtsy@outlook.com>",
  "homepage_url": "https://github.com/Yihtsy/ZotLink",
  "icons": {
    "48": "icons/zotlink-48.png",
    "96": "icons/zotlink-96.png",
    "128": "icons/zotlink-128.png"
  },
  "applications": {
    "zotero": {
      "id": "zotlink@example.com",
      "update_url": "https://github.com/Yihtsy/ZotLink/releases/latest/download/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
